APP_NAME=gamestore-core
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=gamestore
DB_USERNAME=gamestore
DB_PASSWORD=gamestore

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6381
REDIS_DB=0
REDIS_CACHE_DB=1

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local

# --- поставщики (заглушки, шаг Ш4) ---
# Внутри docker-сети — по именам сервисов. С хоста заглушки доступны
# на localhost:8001 и localhost:8002.
SUPPLIER_A_URL=http://supplier-a:8080
SUPPLIER_B_URL=http://supplier-b:8080
SUPPLIER_CONNECT_TIMEOUT=1.0
SUPPLIER_ISSUE_TIMEOUT=3.0
# probe/seal не раньше, чем поставщик мог успеть доработать запрос
SUPPLIER_MAX_PROCESSING=5.0
SUPPLIER_RETRIES=2
# Единственный механизм, способный породить второй код. По умолчанию выключен
# и ни один критерий приёмки его не требует (CLAUDE.md §10.5).
SUPPLIER_ALLOW_COMPENSATED_FALLBACK=false

# --- доставка ---
DELIVERY_LEASE_SECONDS=120
DELIVERY_STUCK_AFTER_MINUTES=15

# --- сверка ---
OPS_TOKEN=change-me-local

# --- состязательные тесты ---
RACE_BARRIER=false
