includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-strict-rules/rules.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: 9

    paths:
        - app
        - config
        - database
        - routes
        - tests

    # Пустой и должен таким остаться. Ошибка уровня 9 чинится типом, а не глушится.
    # Каждая запись сюда требует обоснования в ревью. Baseline запрещён (CLAUDE.md §2.1).
    ignoreErrors: []
    reportUnmatchedIgnoredErrors: true

    strictRules:
        allRules: true
        # Единственное отключённое правило, и оно отключено не ради нашего кода.
        # Larastan объявляет методы Eloquent-билдера (where, count, orderBy и КАЖДЫЙ
        # локальный скоуп) как `@method static`, поэтому любая цепочка вида
        # `Order::query()->where(...)->count()` выглядит для правила как вызов
        # статического метода на объекте. Правило несовместимо с fluent-API
        # фреймворка по построению и помечает идиому, а не дефект.
        # Альтернатива — сотни записей в ignoreErrors, что хуже: она заодно
        # скрыла бы настоящие находки.
        dynamicCallOnStaticMethod: false

    treatPhpDocTypesAsCertain: false
    checkOctaneCompatibility: false

    # env() только в config/ — иначе конфиг-кэш в проде отдаёт null
    noEnvCallsOutsideOfConfig: true

    exceptions:
        # true, а не false. При false PHPStan учитывает только задокументированные
        # броски, а методы HTTP-клиента Laravel их не объявляют — и обработка
        # сетевых сбоев объявляется мёртвым кодом, хотя в рантайме именно она
        # отличает «запрос не ушёл» от «ответ не дошёл». Ошибочный анализ здесь
        # опаснее отсутствия анализа: он подталкивает удалить нужный catch.
        implicitThrows: true
        # Без этого catch (UniqueConstraintViolationException) считается мёртвым,
        # а он — центральная ветка "уже выдано" (CLAUDE.md §5.6)
        reportUncheckedExceptionDeadCatch: false
        check:
            # Выключено вместе с implicitThrows: true. Иначе каждый метод,
            # вызывающий что-либо из фреймворка, обязан объявить @throws Throwable —
            # аннотация без информации, которая обесценивает саму проверку.
            missingCheckedExceptionInThrows: false
            # А это оставлено: @throws, который на деле не бросается, — ложь
            # в документации, и её PHPStan ловит.
            tooWideThrowType: true
        # Checked-исключения отслеживаем ради СВОИХ доменных ошибок (OutOfStock,
        # SupplierUnknown и т.п.) — они обязаны быть в @throws. Инфраструктурные
        # исключения фреймворка объявляем unchecked, иначе @throws RuntimeException
        # расползается по каждой миграции и обесценивает саму проверку.
        uncheckedExceptionClasses:
            - LogicException
            - RuntimeException
            - InvalidArgumentException
            - JsonException
            - Illuminate\Validation\ValidationException
            - Illuminate\Database\Eloquent\ModelNotFoundException
            - Illuminate\Http\Client\ConnectionException
